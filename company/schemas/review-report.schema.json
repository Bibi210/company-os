{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/review-report.schema.json",
  "$defs": {
    "axis": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["approve", "request_changes"]
        },
        "notes": { "type": "string" }
      },
      "required": ["verdict"],
      "additionalProperties": false
    }
  },
  "allOf": [
    { "$ref": "_base.schema.json" },
    {
      "properties": {
        "kind": { "const": "review-report" },
        "metadata": {
          "properties": {
            "round_id": { "type": "string" },
            "reviewer": { "type": "string" }
          },
          "required": ["round_id", "reviewer"]
        },
        "spec": {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": ["approve", "request_changes"]
            },
            "findings": {
              "type": "array",
              "items": { "type": "string" }
            },
            "axes": {
              "type": "object",
              "properties": {
                "nominal": { "$ref": "#/$defs/axis" },
                "negative": { "$ref": "#/$defs/axis" },
                "edge": { "$ref": "#/$defs/axis" }
              },
              "required": ["nominal", "negative", "edge"],
              "additionalProperties": false
            },
            "notes": { "type": "string" },
            "summary": { "type": "string" }
          },
          "required": ["verdict", "findings", "axes"],
          "if": {
            "properties": { "verdict": { "const": "approve" } }
          },
          "then": {
            "properties": {
              "findings": { "maxItems": 0 },
              "axes": {
                "properties": {
                  "nominal": {
                    "properties": { "verdict": { "const": "approve" } }
                  },
                  "negative": {
                    "properties": { "verdict": { "const": "approve" } }
                  },
                  "edge": {
                    "properties": { "verdict": { "const": "approve" } }
                  }
                }
              }
            }
          }
        }
      },
      "required": ["spec"]
    }
  ]
}
