{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/implementation-plan.schema.json",
  "unevaluatedProperties": false,
  "allOf": [
    {
      "$ref": "_base.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "implementation-plan"
        },
        "metadata": {
          "allOf": [
            {
              "$ref": "_base.schema.json#/$defs/metadata"
            }
          ],
          "unevaluatedProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "overview": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "description"
                ]
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "steps"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "spec"
      ]
    }
  ]
}