{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/implementation-plan.schema.json",
  "allOf": [
    { "$ref": "_base.schema.json" },
    {
      "properties": {
        "kind": { "const": "implementation-plan" },
        "spec": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": { "type": "string" },
                  "files": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["description"]
              }
            },
            "dependencies": {
              "type": "array",
              "items": { "type": "string" }
            },
            "risks": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["steps"]
        }
      },
      "required": ["spec"]
    }
  ]
}
