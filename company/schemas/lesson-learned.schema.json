{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/lesson-learned.schema.json",
  "unevaluatedProperties": false,
  "allOf": [
    {
      "$ref": "_base.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "lesson-learned"
        },
        "metadata": {
          "allOf": [
            {
              "$ref": "_base.schema.json#/$defs/metadata"
            }
          ],
          "unevaluatedProperties": false,
          "required": [
            "tags",
            "description"
          ]
        },
        "spec": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "minLength": 1
            },
            "insight": {
              "type": "string",
              "minLength": 1
            },
            "recommendation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "context",
            "insight",
            "recommendation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "spec"
      ]
    }
  ]
}