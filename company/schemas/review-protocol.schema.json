{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/review-protocol.schema.json",
  "allOf": [
    { "$ref": "_base.schema.json" },
    {
      "properties": {
        "kind": { "const": "review-protocol" },
        "spec": {
          "type": "object",
          "properties": {
            "reviewers_by_artifact_type": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "self_review_forbidden": {
              "type": "object",
              "properties": { "description": { "type": "string" } },
              "required": ["description"]
            },
            "review_analysis_framework": {
              "type": "object",
              "properties": { "description": { "type": "string" } },
              "required": ["description"]
            }
          },
          "required": ["reviewers_by_artifact_type"],
          "additionalProperties": false
        }
      },
      "required": ["spec"]
    }
  ]
}
