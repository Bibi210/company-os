{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/rfc.schema.json",
  "allOf": [
    { "$ref": "_base.schema.json" },
    {
      "properties": {
        "kind": { "const": "rfc" },
        "metadata": {
          "properties": {
            "status": {
              "type": "string",
              "enum": ["draft", "review", "approved", "rejected", "implemented"]
            }
          }
        },
        "spec": {
          "type": "object",
          "properties": {
            "motivation": { "type": "string" },
            "proposal": { "type": "string" },
            "impact": { "type": "string" },
            "rollback_plan": { "type": "string" },
            "affected_files": {
              "anyOf": [
                {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Legacy flat form: a single list of file paths (modified or created indistinctly). Kept for backward compatibility."
                },
                {
                  "type": "object",
                  "properties": {
                    "modified": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Files that already exist in HEAD and will be edited."
                    },
                    "created": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "New files that do not yet exist and will be created."
                    },
                    "deleted": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Files that exist in HEAD and will be deleted. Evaluated by the path-matchable human-review triggers (mechanism 15, RFC 0197fbe5)."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Structured form distinguishing files to modify, create, and delete. All three keys optional; any may be empty or absent."
                }
              ]
            }
          },
          "required": ["motivation", "proposal", "impact"]
        }
      },
      "required": ["spec"]
    }
  ]
}
