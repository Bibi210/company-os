{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/human-review-triggers.schema.json",
  "allOf": [
    { "$ref": "_base.schema.json" },
    {
      "properties": {
        "kind": { "const": "human-review-triggers" },
        "spec": {
          "type": "object",
          "properties": {
            "triggers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "condition": { "type": "string" },
                  "action": { "type": "string" },
                  "description": { "type": "string" },
                  "match": {
                    "type": "object",
                    "properties": {
                      "paths": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 1
                      },
                      "on": {
                        "type": "string",
                        "enum": ["any", "deleted"]
                      }
                    },
                    "required": ["paths", "on"],
                    "additionalProperties": false
                  }
                },
                "required": ["condition", "action", "description"],
                "additionalProperties": false
              }
            }
          },
          "required": ["triggers"],
          "additionalProperties": false
        }
      },
      "required": ["spec"]
    }
  ]
}
