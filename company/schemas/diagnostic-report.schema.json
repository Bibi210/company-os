{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/diagnostic-report.schema.json",
  "unevaluatedProperties": false,
  "allOf": [
    {
      "$ref": "_base.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "diagnostic-report"
        },
        "metadata": {
          "allOf": [
            {
              "$ref": "_base.schema.json#/$defs/metadata"
            }
          ],
          "unevaluatedProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "symptom": {
              "type": "string",
              "minLength": 1
            },
            "root_cause": {
              "type": "string"
            },
            "resolution": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "investigating",
                "resolved",
                "wont_fix"
              ]
            }
          },
          "required": [
            "symptom",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "spec"
      ]
    }
  ]
}