{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/flow-control.schema.json",
  "allOf": [
    { "$ref": "_base.schema.json" },
    {
      "properties": {
        "kind": { "const": "flow-control" },
        "spec": {
          "type": "object",
          "properties": {
            "max_review_iterations": { "type": "integer", "minimum": 1 }
          },
          "required": ["max_review_iterations"],
          "additionalProperties": false
        }
      },
      "required": ["spec"]
    }
  ]
}
